          "cookies": [],
          "content": {
            "size": 3006,
            "mimeType": "text/html",
            "text": "<style type=\"text/css\">\n\n  .clickToEditObs {\n    margin-left: 0px;\n  }\n  .preformatted-note {\n    margin: 1px;\n    padding: 0px;\n    padding-top: 1px;\n    background: white;\n    color: #e9241d;\n    font-family: \"OpenSans\", Arial, sans-serif;\n    font-weight: bold;\n    font-size: 0.8em;\n  }\n  .preformatted-note.empty {\n    padding-top: 0px;\n  }\n  .note-wrapper {\n    float: left;\n    max-width: 92%;\n    min-height: 20px;\n    border: solid 2px #e9241d;\n    border-radius:2px;\n    padding-left: 4px;\n    padding-right: 4px;\n    background: white;\n    font-family: \"OpenSans\", Arial, sans-serif;\n    cursor: pointer;\n  }\n  .note-wrapper.no-borders {\n    border: none;\n    padding: 0;\n    background: none;\n  }\n  .editable-input {\n    width: 100%!important;\n    margin: 0px;\n    -webkit-box-sizing: border-box!important;\n    -moz-box-sizing: border-box!important;\n    box-sizing: border-box!important;\n    font-size: 0.9em;\n  }\n  .editable-buttons {\n    float: right;\n  }\n  .editable-buttons > .btn {\n    min-width: 33px;\n    min-height: 25px;\n    border: none;\n    padding: 2px;\n    background: none;\n    color: black\n  }\n  .editable-hide {\n    display: none !important;\n  }\n  .icon-sticky-note {\n    position: absolute;\n    border-radius: 2px;\n    padding: 0;\n    padding-left: 2px;\n    padding-right: 2px;\n    background: #00463f;\n    color: yellow;\n    font-size: 20px;\n  }\n  .icon-sticky-note:before {\n    position: relative;\n    top: 1px;\n    font-size: 20px;\n  }\n  .icons-wrapper {\n    cursor: pointer;\n  }\n  .icon-wrapper > .icon-remove {\n    color: #666666;\n  }\n  .icons-wrapper > .icon-remove:hover {\n    color: #999999;\n  }\n  .details {\n    margin-top:3px;\n    font-size: 0.8em;\n  }\n  .created-by {\n    font-weight: bold;\n    color: #666666;\n  }\n  .created-date {\n    clear: both;\n    font-weight: normal;\n    font-size: 0.7em;\n    color: #666666;\n  }\n  .secondLine {\n    clear:both;\n  }\n  .other-actions {\n    display: none;\n  }\n\n</style>\n\n<div class=\"clickToEditObs\">\n  <div class=\"firstLine\">\n    <span class=\"note-wrapper\" ng-class=\"{'no-borders': isEditing || isEmpty}\"><span id=\"TextField\" onhide=\"toggleEditMode()\" onshow=\"toggleEditMode()\" editable-textarea=\"note.text\" e-placeholder=\"{{ msgs[module.getProvider() + '.clickToEditObs.placeholder'] }}\" e-rows=\"7\" e-cols=\"40\" onaftersave=\"updateObs()\" ><pre class=\"preformatted-note\" ng-class=\"{empty: isEmpty}\">{{ note.text }}<i ng-show=\"isEmpty\" class=\"icon-sticky-note\"></i></pre></span></span>\n    <span class=\"icons-wrapper\">\n      <div ng-hide=\"isEditing || isEmpty\" class=\"icon-remove\" ng-click=\"confirmDelete()\"></div>\n    </span>\n  </div>\n  <div class=\"details secondLine\" ng-hide=\"isEmpty || isEditing\">\n    <span class=\"created-by\">{{ note.createdBy }} </span><span class=\"created-date\">{{ note.creationDate }}</span>\n  </div>\n  <div class=\"other-actions\" ng-show=\"showActions\">\n   <i ng-hide=\"isEditing || isEmpty\" class=\"icon-chevron-left\"></i>\n   <i ng-hide=\"isEditing || isEmpty\" class=\"icon-chevron-right\"></i>\n </div>\n</div>"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
          "_error": null,
          "_fetchedViaServiceWorker": false
        },
