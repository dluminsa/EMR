rd\",\"Order.orderable\":\"Orderable\",\"reportingcompatibility.PatientSearch.edit\":\"Edit Patient Searches\",\"Form.not.saved\":\"Form was not saved\",\"emrapi.visitDataDefinition.mostRecentAdmissionRequest.name\":\"Most Recent Admission Request\",\"xforms.externalSource\":\"External Source\",\"narrative.propertyName.address\":\"Address\",\"reportingui.adHocManage.confirmDeleteMessage\":\"Are you sure?\",\"xforms.fontWeight\":\"Font Weight\",\"options.login.secretAnswerNew\":\"New Secret Answer\",\"appointmentscheduling.AppointmentType.retireAppointmentType\":\"Retire Appointment Type\",\"emr.units.inches\":\"in\",\"Patient.delete\":\"Delete Patient Forever\",\"stockmanagement.report.commonname\":\"Common Name\",\"coreapps.clinicianfacing.noneRecorded\":\"None\",\"referenceapplication.app.legacy.findPatient.label\":\"(Legacy) Find/Create patient\",\"appointmentscheduling.Appointment.list.button.checkIn\":\"Check-In\",\"xforms.languages\":\"Languages\",\"reporting.editScheduledReport\":\"Edit Scheduled Report\",\"Privilege.save\":\"Save Privilege\",\"SystemInfo.JavaRuntimeEnv.javaVersion\":\"Java Version\",\"reporting.runReport.schedule.everyDay\":\"Every day\",\"stockmanagement.stockitem.conceptexists\":\"Stock item with concept already exists\",\"addresshierarchy.admin.configureAddressToEntryMappings\":\"Configure Address to Entry Mappings\",\"patientflags.flags\":\"Flags\",\"Order.voidOrder\":\"Delete this Order\",\"Module.upload\":\"Upload\",\"metadatasharing.importMetadata\":\"Import Metadata\",\"Patient.removeThisIdentifier\":\"Remove this identifier\",\"reportingcompatibility.DataExport.allLocations\":\"All Locations\",\"narrative.propertyName.asserter\":\"Asserter\",\"ConceptMapType.hidden.help\":\"Setting this to true will make this concept map type unvailable for usage however, it won't be retired\",\"narrative.propertyName.dispenseInterval\":\"Dispense Interval\",\"metadatasharing.configure.saved\":\"Configuration saved successfully\",\"Order.add\":\"Add