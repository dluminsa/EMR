.defaultLocale\":\"Default Locale\",\"coreapps.deadPatient.description\":\"This patient is deceased. If you wish to view or edit details of a previous visit, choose a visit from the list on the left.\",\"reporting.reportRequest.additionalProcessing\":\"Additional report processing\",\"State.delete.confirmation\":\"Are you sure you want to delete this state?\",\"ugandaemr.submit.label\":\"Submit\",\"reporting.DelimitedTextReportRenderer.tab\":\"Tab\",\"reportingcompatibility.CohortBuilder.whenPrefix\":\"When?\",\"metadatasharing.import.mode.parentAndChild.description\":\"Import a package from your implementation's master metadata server. This will trust the package to overwrite your existing metadata.\",\"general.edit\":\"Edit\",\"ugandaemr.app.triage.patientqueue.title\":\"TRIAGE\",\"general.or\":\"or\",\"install.simple\":\"Simple\",\"Visit.enterEndDate\":\"Enter the end date of the visit\",\"xforms.setPatientDownloadCohort\":\"Set as the cohort for patients to download.\",\"＃Scheduler.taskForm.id\":\"＃Scheduler.taskForm.id\",\"error.number\":\"Not a valid number\",\"stockmanagement.dashboard.description\":\"A dashboard for managing stock operations\",\"general.of\":\"of\",\"reporting.run.title\":\"Analysis & Reporting\",\"stockmanagement.stockoperation.destinationlocationtagnotmatched\":\"Destination location specified does not match required operation tags\",\"SystemInfo.title.memoryInformation\":\"Memory Information\",\"coreapps.conditionui.activeConditions\":\"Active Conditions\",\"Obs.delete\":\"Delete Selected Observations\",\"general.no\":\"No\",\"Encounter.transfer.change\":\"change\",\"appointmentscheduling.Appointment.list.manage\":\"Manage Appointments\",\"general.answer\":\"Answer\",\"adminui.provider.details\":\"Provider Details\",\"install.advanced.admin\":\"Step 4 of 5\",\"htmlformentry.orders.encounterDateChangeWarning\":\"Warning, changing the encounter date will reset any newly entered drug order fields and will not automatically change the date of