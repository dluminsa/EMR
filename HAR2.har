            "text": "{\"results\":[{\"uuid\":\"750b379f-1e30-400e-8d12-c212d8e281d5\",\"display\":\"Text of encounter note: EMTCT BF\",\"concept\":{\"uuid\":\"162169AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"display\":\"Text of encounter note\",\"name\":{\"display\":\"Text of encounter note\",\"uuid\":\"124962BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\",\"name\":\"Text of encounter note\",\"locale\":\"en\",\"localePreferred\":true,\"conceptNameType\":\"FULLY_SPECIFIED\",\"links\":[{\"rel\":\"self\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/concept/162169AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/name/124962BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\"},{\"rel\":\"full\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/concept/162169AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/name/124962BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB?v=full\"}],\"resourceVersion\":\"1.9\"},\"datatype\":{\"uuid\":\"8d4a4ab4-c2cc-11de-8d13-0010c6dffd0f\",\"display\":\"Text\",\"links\":[{\"rel\":\"self\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/conceptdatatype/8d4a4ab4-c2cc-11de-8d13-0010c6dffd0f\"}]},\"conceptClass\":{\"uuid\":\"8d491e50-c2cc-11de-8d13-0010c6dffd0f\",\"display\":\"Question\",\"links\":[{\"rel\":\"self\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/conceptclass/8d491e50-c2cc-11de-8d13-0010c6dffd0f\"}]},\"set\":false,\"version\":\"\",\"retired\":false,\"names\":[{\"uuid\":\"124962BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\",\"display\":\"Text of encounter note\",\"links\":[{\"rel\":\"self\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/concept/162169AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/name/124962BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\"}]}],\"descriptions\":[{\"uuid\":\"17164FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF\",\"display\":\"Free text note field intended to capture unstructured description of the patient encounter\",\"links\":[{\"rel\":\"self\",\"uri\":\"http://localhost:8081/openmrs/ws/rest/v1/concept/162169AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/description/17164FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF\"}]}],\"mappings\":[{\"uuid\":\"237188ABBBBBBBBBBBBBBBB